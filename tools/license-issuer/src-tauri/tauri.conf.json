{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "上岸资料库授权签发工具",
  "version": "0.7.0",
  "identifier": "com.shangan.licenseissuer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "上岸资料库 · 授权签发工具",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
